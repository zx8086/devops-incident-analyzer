	"prompts": [
		{
			"name": "generate_sqlpp_query",
			"arguments": [
				{
					"name": "description",
					"description": "What you want to accomplish with this query",
					"required": true
				},
				{
					"name": "bucket",
					"description": "The bucket name (e.g., 'travel-sample')",
					"required": true
				},
				{
					"name": "scope",
					"description": "The scope name (e.g., 'inventory'). If not provided, '_default' will be used",
					"required": false
				},
				{
					"name": "collection",
					"description": "The collection name (e.g., 'hotel')",
					"required": true
				},
				{
					"name": "filters",
					"description": "Any conditions for filtering results",
					"required": false
				},
				{
					"name": "limit",
					"description": "Maximum number of results to return",
					"required": false
				}
			]
		}
	]
