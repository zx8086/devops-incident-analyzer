		"@devops-agent/mcp-server-gitlab": "workspace:*",
		"@devops-agent/mcp-server-kafka": "workspace:*",
		"@devops-agent/mcp-server-konnect": "workspace:*",
		"@devops-agent/shared": "workspace:*",
		"@modelcontextprotocol/sdk": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:dev",
		"bun-types": "catalog:dev",
		"typescript": "catalog:dev"
