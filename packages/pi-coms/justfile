set dotenv-load := true

default:
    @just --list

# Auto-kills any stale process holding the pinned port first.

# Start a local coms-net hub (binds 127.0.0.1, OS-claimed port unless PI_COMS_NET_PORT is set)
coms-net-server:
    -lsof -ti :${PI_COMS_NET_PORT:-52965} | xargs -r kill -TERM 2>/dev/null
    bun scripts/coms-net-server.ts

# Start a LAN-visible coms-net hub (binds 0.0.0.0, requires PI_COMS_NET_AUTH_TOKEN)
coms-net-server-lan:
    -lsof -ti :${PI_COMS_NET_PORT:-52965} | xargs -r kill -TERM 2>/dev/null
    PI_COMS_NET_HOST=0.0.0.0 bun scripts/coms-net-server.ts

# The agent name flag is --cname (pi owns --name). The recipe sets both from one
# value: the pi session is named "<cname> <timestamp>" so runs are traceable in
# pi's session list, and --explicit keeps the operator out of peer auto-discovery.
# Extra args pass through to pi, e.g.: just coms laptop --model claude-opus-4-7

# Pi console: `just coms <env|profile|account> <cname>` against a DEPLOYED hub
# (needs that hub's tunnel open), or `just coms <cname>` against a local one.
coms first *rest:
    #!/usr/bin/env bash
    set -euo pipefail
    MANIFEST="{{justfile_directory()}}/deploy/fleet.yaml"
    ENV_KEY=""; PROFILE=""; REGION=""; PORT=""; LOCAL_PORT=""; PROJECT=""
    SEL=""; CNAME="{{first}}"; ARGS=({{rest}})
    # `just coms <selector> <cname>` targets a DEPLOYED hub; `just coms <cname>`
    # keeps its local-hub meaning. The first word is a selector only when the
    # manifest actually has a hub by that name/profile/account (resolver exit 3
    # = no match), so a cname can never be mistaken for a hub.
    if [ -f "$MANIFEST" ] && [ ${#ARGS[@]} -gt 0 ]; then
      if RESOLVED="$(bun {{justfile_directory()}}/scripts/hub-tunnel-target.ts "$MANIFEST" "{{first}}" 2>/dev/null)"; then
        eval "$RESOLVED"
        SEL="{{first}}"; CNAME="${ARGS[0]}"; ARGS=("${ARGS[@]:1}")
      fi
    fi
    if [ -z "$SEL" ]; then
      exec pi -e extensions/coms-net.ts --name "$CNAME $(date +%Y-%m-%dT%H:%M)" --cname "$CNAME" --explicit "${ARGS[@]}"
    fi
    if [ -z "$PROJECT" ]; then echo "hub \"$SEL\" has no project in the manifest" >&2; exit 1; fi
    if ! lsof -nP -iTCP:"$LOCAL_PORT" -sTCP:LISTEN >/dev/null 2>&1; then
      echo "no tunnel on localhost:$LOCAL_PORT -- run: just hub-tunnel $SEL" >&2
      exit 1
    fi
    # Operator token from SSM, never echoed. The console registers under this
    # principal, so its name must be in the principal's allowed names.
    TOKEN="$(aws ssm get-parameter --profile "$PROFILE" --region "$REGION" \
      --name "/pi-coms/auth/$CNAME" --with-decryption \
      --query Parameter.Value --output text 2>/dev/null \
      | python3 -c 'import json,sys; print(json.load(sys.stdin)["token"])' 2>/dev/null || true)"
    if [ -z "$TOKEN" ]; then
      echo "no principal \"$CNAME\" on the $ENV_KEY hub; mint one: just token-create $CNAME \"$CNAME,ops\" operator $PROFILE" >&2
      exit 1
    fi
    echo "coms-net: $ENV_KEY hub via localhost:$LOCAL_PORT (project $PROJECT) as $CNAME"
    exec pi -e extensions/coms-net.ts \
      --name "$CNAME $(date +%Y-%m-%dT%H:%M)" --cname "$CNAME" --explicit \
      --server-url "http://127.0.0.1:$LOCAL_PORT" --auth-token "$TOKEN" --project "$PROJECT" "${ARGS[@]}"
# Fleet auth principals (SSM-backed; IAM on /pi-coms/auth decides who may run these)

# Mint a principal token: just token-create <principal> ["name1,name2"] [kind] [profile]
token-create principal names="" kind="operator" profile="":
    ./deploy/token-admin.sh create {{principal}} "{{names}}" "{{kind}}" "{{profile}}"

# Revoke a principal token (live sessions evicted on the hub's next refresh)
token-revoke principal profile="":
    ./deploy/token-admin.sh revoke {{principal}} "{{profile}}"

# List principals, kinds and names (never tokens)
token-list profile="":
    ./deploy/token-admin.sh list "{{profile}}"

# SSM port-forward to a hub. The selector is an environment key, an AWS profile
# or an account id -- a fleet can run more than one hub per environment, so
# keying only on the environment would make a second one unaddressable. All
# three of these open the same tunnel:
#   just hub-tunnel prd
#   just hub-tunnel eu-shared-services-prd
#   just hub-tunnel 399987695868
# Profile, region, hub port and local port come from deploy/fleet.yaml (the same
# manifest `just fleet` reads), falling back to built-in defaults when that
# gitignored file is absent.
#
# The instance is resolved by its Name tag at connect time: instance ids change
# on replacement, the tag does not. Each hub gets a distinct LOCAL port so
# several tunnels can be open at once -- set `local_port` on the hub in the
# manifest, or let it derive from the environment (prd +1, stg +2). Override per
# invocation with `--local-port N`. A positional second argument is the HUB's
# port (what the tunnel forwards to), e.g. `just hub-tunnel eu-shared-services-prd
# 8787`; it never changes the local port.

# SSM port-forward to a hub: just hub-tunnel <env|profile|account> [hub-port] [--local-port N]
hub-tunnel selector="dev" port="" *args:
    #!/usr/bin/env bash
    set -euo pipefail
    SEL="{{selector}}"
    PORT_OVERRIDE="{{port}}"
    LOCAL_OVERRIDE=""
    ARGS=({{args}})
    i=0
    while [ $i -lt ${#ARGS[@]} ]; do
      case "${ARGS[$i]}" in
        --local-port) i=$((i+1)); LOCAL_OVERRIDE="${ARGS[$i]:-}" ;;
        --local-port=*) LOCAL_OVERRIDE="${ARGS[$i]#*=}" ;;
        *) echo "unexpected argument \"${ARGS[$i]}\" (usage: just hub-tunnel <env|profile|account> [hub-port] [--local-port N])" >&2; exit 1 ;;
      esac
      i=$((i+1))
    done
    MANIFEST="{{justfile_directory()}}/deploy/fleet.yaml"
    ENV_KEY=""; PROFILE=""; REGION=""; PORT=""; LOCAL_PORT=""
    if [ -f "$MANIFEST" ]; then
      RESOLVED="$(bun {{justfile_directory()}}/scripts/hub-tunnel-target.ts "$MANIFEST" "$SEL")" || exit 1
      eval "$RESOLVED"
    fi
    # Built-in fallback when the manifest is absent (it is gitignored).
    if [ -z "$PROFILE" ]; then
      case "$SEL" in
        dev) PROFILE="eu-shared-services-dev"; ENV_KEY="dev" ;;
        prd) PROFILE="eu-shared-services-prd"; ENV_KEY="prd" ;;
        stg) PROFILE="eu-shared-services-stg"; ENV_KEY="stg" ;;
        *-dev|*-prd|*-prod|*-stg) PROFILE="$SEL"; ENV_KEY="${SEL##*-}" ;;
        *) echo "unknown hub \"$SEL\" and no deploy/fleet.yaml to resolve it" >&2; exit 1 ;;
      esac
      PORT="8787"
      case "$ENV_KEY" in
        prd|prod) LOCAL_PORT=$((PORT + 1)) ;;
        stg)      LOCAL_PORT=$((PORT + 2)) ;;
        *)        LOCAL_PORT="$PORT" ;;
      esac
    fi
    REGION="${REGION:-eu-central-1}"
    # A positional port is the HUB's listening port (what the tunnel forwards
    # TO), matching the AWS-side meaning. The local port stays derived unless
    # --local-port says otherwise, so naming the hub port cannot silently move
    # the local one onto another environment's port.
    if [ -n "$PORT_OVERRIDE" ]; then PORT="$PORT_OVERRIDE"; fi
    LOCAL="${LOCAL_OVERRIDE:-$LOCAL_PORT}"
    HUB_ID=$(aws ec2 describe-instances --profile "$PROFILE" --region "$REGION" \
      --filters "Name=tag:Name,Values=pi-coms-hub" "Name=instance-state-name,Values=running" \
      --query "Reservations[].Instances[].InstanceId" --output text)
    if [ -z "$HUB_ID" ] || [ "$HUB_ID" = "None" ]; then echo "no running hub instance found in $PROFILE" >&2; exit 1; fi
    if lsof -nP -iTCP:"$LOCAL" -sTCP:LISTEN >/dev/null 2>&1; then
      echo "local port $LOCAL is already in use (another hub tunnel?): just hub-tunnel $SEL --local-port <free-port>" >&2
      exit 1
    fi
    echo "hub instance: $HUB_ID ($ENV_KEY / $PROFILE) port $PORT -> localhost:$LOCAL"
    exec aws ssm start-session --profile "$PROFILE" --region "$REGION" --target "$HUB_ID" \
      --document-name AWS-StartPortForwardingSession \
      --parameters "{\"portNumber\":[\"$PORT\"],\"localPortNumber\":[\"$LOCAL\"]}"


# Regenerate AGENTS.md (the operator console persona) from agents/pi-fleet via
# the gitagent bridge exporter (SIO-1649). Run after editing the definition;
# a bridge test pins the committed file to the export.
sync-persona:
    #!/usr/bin/env bash
    set -euo pipefail
    root="$(git rev-parse --show-toplevel)"
    out="$(mktemp -d)"
    (cd "$root" && bun packages/gitagent-bridge/src/export-pi-package-cli.ts --agent pi-fleet --out "$out")
    cp "$out/AGENTS.md" "{{justfile_directory()}}/AGENTS.md"
    rm -rf "$out"
    echo "AGENTS.md regenerated from agents/pi-fleet"

# Manifest-driven fleet deploy (SIO-1653): just fleet <preflight|tokens ensure|rotate|render|backend-init <env>|plan|apply [--yes]|publish|rollout|status|deploy> [names]
fleet *args:
    bun scripts/fleet.ts {{args}}
