{
	"compilerOptions": {
		"strict": true,
		"noEmit": true,
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"types": ["bun"]
	},
	"include": ["contracts/**/*.ts", "extensions/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
