{
	"$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
	"files": {
		"includes": [
			"**",
			"!**/.svelte-kit",
			"!migrate",
			"!.worktrees",
			"!current",
			"!.claude/worktrees",
			"!guides",
			"!docs/reference/agent-memory-openapi.json",
			"!.fallow",
			"!packages/pi-coms/deploy",
			"!packages/pi-coms/scripts/node_modules",
			"!packages/pi-coms/vendor"
		]
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noExplicitAny": "error"
			}
		}
	},
	"formatter": { "enabled": true, "indentWidth": 2, "lineWidth": 120 },
	"css": {
		"parser": { "cssModules": true, "tailwindDirectives": true },
		"linter": { "enabled": false },
		"formatter": { "enabled": false }
	},
	"overrides": [
		{
			"includes": ["**/*.svelte"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedImports": "off",
						"noUnusedVariables": "off"
					}
				}
			},
			"formatter": {
				"formatWithErrors": true
			}
		}
	]
}
